# Helius RPC key. The network's Helius host serves the RPC, the indexer and the
# TEE prover at /v1/spr, and the private-wallet gateway at /v1/private-wallet.
API_KEY=YOUR_KEY

# The network: devnet (default) or mainnet. It picks the Helius host, its
# private-wallet gateway and the enrollment domain on it, the release the
# client verifies the enclave against, the enrollment chain and the prover
# policy. Mainnet needs a release pinned in @heliuslabs/spr-embedded-wallet.
# SPR_NETWORK=devnet

# The wallet owner: a Turnkey sub-organization named after API_KEY's Helius
# project, and a root user's API key in it, either the key pair or a Turnkey API
# key file ({"public_key": hex, "private_key": hex}). Keep the credential out of
# browser code.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# TURNKEY_API_KEY_PATH=/path/to/api_key.json
# The wallet's Solana address. Leave it empty to have the first run create a
# wallet in the organization; set it to the printed address afterwards.
TURNKEY_WALLET_ADDRESS=

# Files this example writes and reads. Keep them out of version control. The
# first run enrolls the client key with the gateway and stores the descriptor,
# which is for one network: use another path per network.
TVC_CLIENT_KEY_PATH=./tvc-client-key.json
TVC_DESCRIPTOR_PATH=./tvc-wallet-descriptor.json
TVC_WALLET_PATH=./tvc-wallet.json

# Optional overrides of the Helius routes.
# ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# ZOLANA_INDEXER_URL=https://devnet.helius-rpc.com/v1/spr?api-key=YOUR_KEY
# ZOLANA_PROVER_URL=https://devnet.helius-rpc.com/v1/spr?api-key=YOUR_KEY
# The prover the enclave seals witnesses to; defaults to gatekeeper's /v1/spr.
# TVC_PROVER_URL=https://devnet.helius-rpc.com/v1/spr?api-key=YOUR_KEY
# The private-wallet gateway; defaults to the network's /v1/private-wallet.
# TVC_GATEWAY_URL=https://devnet.helius-rpc.com/v1/private-wallet?api-key=YOUR_KEY

# SPL example only: a mint registered with the pool, its asset id, and the
# wallet's token account the deposit leaves from.
# SPL_MINT=
# SPL_ASSET_ID=
# SPL_TOKEN_ACCOUNT=
# SPL_AMOUNT=200000

# Local run instead of a deployment: `just headless-e2e` sets all of these for
# its fresh localnet. The testkit stands in for the enclave and this
# keypair for the Turnkey wallet. Disposable test material only.
# TVC_LOCAL_TESTKIT_ENDPOINT=http://127.0.0.1:44020
# TVC_SOLANA_KEYPAIR_PATH=/path/to/disposable-solana-keypair.json
# ZOLANA_ENDPOINT=http://127.0.0.1:9099
# ZOLANA_INDEXER_URL=http://127.0.0.1:8984
# ZOLANA_PROVER_URL=http://127.0.0.1:3201
# With a testkit started with --live-prover, a TEE prover of the network the
# enclave seals to under its signed policy, in place of the stand-in prover.
# TVC_PROVER_URL=https://devnet.helius-rpc.com/v1/spr?api-key=YOUR_KEY
