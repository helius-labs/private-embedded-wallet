{
  "name": "zolana-tvc-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Turnkey Verifiable Compute application and TypeScript client for Zolana private wallets",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:ts": "pnpm --filter @zolana/tvc-wallet --filter @zolana/tvc-wallet-kit build",
    "lint:ts": "eslint packages/tvc-wallet packages/tvc-wallet-kit examples/privacy-wallet-next-app/src examples/typescript-client/src examples/typescript-client/examples apps/tvc-gateway/e2e eslint.config.js --max-warnings 0",
    "test:ts": "pnpm --filter @zolana/tvc-wallet --filter @zolana/tvc-wallet-kit test",
    "typecheck:ts": "pnpm --filter @zolana/tvc-wallet --filter @zolana/tvc-wallet-kit typecheck",
    "ci:ts": "pnpm lint:ts && pnpm typecheck:ts && pnpm test:ts && pnpm build:ts && pnpm typecheck:examples && pnpm test:examples && pnpm typecheck:e2e",
    "typecheck:examples": "pnpm --filter zolana-tvc-typescript-client-example --filter zolana-privacy-wallet-next-app typecheck",
    "test:examples": "pnpm --filter zolana-tvc-typescript-client-example --filter zolana-privacy-wallet-next-app test",
    "typecheck:e2e": "pnpm --filter @zolana/tvc-gateway-e2e typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@lightprotocol/hasher.rs@0.2.1": "patches/@lightprotocol__hasher.rs@0.2.1.patch",
      "@turnkey/react-wallet-kit@2.4.1": "patches/@turnkey__react-wallet-kit@2.4.1.patch"
    }
  }
}
