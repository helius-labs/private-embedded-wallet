{
  "name": "@heliuslabs/spr-embedded-wallet",
  "version": "0.0.0",
  "description": "TVC client for attested Solana Privacy Rings wallets: verified connection, bootstrap, and the SDK's WalletKeys answered by the enclave.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./operator": {
      "types": "./dist/operator.d.ts",
      "import": "./dist/operator.js",
      "require": "./dist/operator.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@peculiar/x509": "1.12.3",
    "@turnkey/crypto": "2.11.3",
    "@turnkey/sdk-types": "1.5.1"
  },
  "peerDependencies": {
    "@heliuslabs/spr": ">=0.9.0-alpha",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@solana/kit": "^8.3.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
